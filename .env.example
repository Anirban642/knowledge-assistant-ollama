# ---------- Application ----------
APP_NAME=Company Knowledge Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list). [] disables CORS.
CORS_ALLOWED_ORIGINS=[]

# ---------- Documents and chunking ----------
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------- Ollama (local LLM and embeddings) ----------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=180
# 0 = force CPU. Comment this out to let Ollama use your GPU.
LLM_NUM_GPU=0

# ---------- Vector database (ChromaDB) ----------
# Relative paths are relative to the project root. Keep this OUTSIDE OneDrive on Windows.
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=company_knowledge

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=4
# Chunks farther away than this are ignored (lower = stricter). Tuned on a small handbook.
RETRIEVAL_MAX_DISTANCE=0.45
SOURCE_DISTANCE_MARGIN=0.08
MAX_SOURCES=3

# ---------- Conversations ----------
CONVERSATION_HISTORY_TURNS=3
CONVERSATION_MAX_SESSIONS=500